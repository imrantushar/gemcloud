#: assets/build/app.1.0.0.js:6
msgid "Offload new uploads"
msgstr ""

#: assets/build/app.1.0.0.js:6
msgid "Every new media library file, and every image size WordPress generates, is copied to the cloud in the background. URLs switch to the cloud only once the upload is verified, so a failed upload never shows a broken image."
msgstr ""

#: assets/build/app.1.0.0.js:6
msgid "What happens to the copy on this server after a verified upload."
msgstr ""

#: assets/build/app.1.0.0.js:6
msgid "Keep local copies (Sync mode)"
msgstr ""

#: assets/build/app.1.0.0.js:6
msgid "The cloud gets a copy, nothing is deleted. No disk space is freed, but every plugin that reads files from disk keeps working."
msgstr ""

#: assets/build/app.1.0.0.js:6
msgid "Deletes thumbnails and other generated sizes; originals stay as a backup. Most of the disk saving, very little risk."
msgstr ""

#: assets/build/app.1.0.0.js:6
msgid "Remove all local files (Offload mode)"
msgstr ""

#: assets/build/app.1.0.0.js:6
msgid "Deletes every local copy. When the image editor, thumbnail regeneration or another plugin needs a file, it is downloaded back automatically for a day."
msgstr ""

#: assets/build/app.1.0.0.js:6
msgid "Path prefix"
msgstr ""

#: assets/build/app.1.0.0.js:6
msgid "Automatic"
