#: assets/build/app.1.0.0.js:6
msgid "Private media"
msgstr ""

#: assets/build/app.1.0.0.js:6
msgid "Any media library file can be marked “Private” in its attachment details. It then moves to the private bucket and is served through a signed URL to logged-in users who can read it."
